<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Invoice</title>
<style>
  .invoice-box {
  font-family: Arial, sans-serif;
  box-sizing: border-box; 
  max-width: 21 cm;
  margin: auto;
  padding: 30px;
  /* border: 2px solid #eee; */
  /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.15); */
}

  .header-section { text-align: center; }
  .address-left {
      justify-content: space-between;
      width: 48%;
      text-align: left; 
      float: left;
  }
  .address-right {
      justify-content: space-between;
      text-align: right; 
      width: 48%;
      float: right;
  }
  .invoice-details-right {
      justify-content: space-between;
      text-align: right; 
      width: 48%;
      float: right;
  }
  .invoice-details-left {
      justify-content: space-between;
      text-align: left; 
      width: 48%;
      float: left;
  }
  p { 
      margin: 0 0 1px;
      font-size: x-small;
  }
  table {
      border-collapse: collapse;
      width: auto;
      margin-top: 20px;
      max-width: calc(100% - 40px);
      font-size: x-small;
  }
  th, td {
      border: 1px solid #000;
      padding: 5px;
      text-align: left;
  }
  th {
      background-color: #f2f2f2;
      font-weight: bold;
  }
  td.total {
      font-weight: bold;
      text-align: right;
  }
  .less-line-distance{
    line-height: 0.3;
  }
  h5{
    margin: 0.3cm 0cm;
    font-size: x-small;
  }
</style>
</head>
<body>
<div class="invoice-box">
    <div class="header-section">
        <img src="<%= company_logo %>" alt="Company logo" class="logo" width="100" height="50">
        <h3>Tax Invoice</h3>
    </div>
    <div class="address-left">
        <h5>Sold By:</h5>
        <p><%= company_name %></p>
        <p><%= company_address %></p>
        <p><%= company_state %>, <%= company_pincode %></p>
        <h6>GST Registration No: <%= company_gst %></h6>
    </div>
    <div class="address-right">
        <h5>Shipping Address/ Billing Address :</h5>
        <p><%= shipping_name %></p>
        <p><%= shipping_address %></p>
        <p><%= shipping_city %>, <%= shipping_state %>, <%= shipping_pincode %></p>
    </div>
    <div class="address-right less-line-distance">
        <h5>Invoice Number: <%= invoice_number %></h5>
        <h5>Invoice Date: <%= invoice_date %></h5>
        <h5>Order Number: <%= order_number %></h5>
        <h5>Order Date: <%= order_date %></h5>
    </div>
    <table>
        <thead>
            <tr>
                <th style="max-width: 0.5cm;">Sl. No</th>
                <th style="min-width: 5cm;max-width: 5cm;">Description</th>
                <th style="max-width: 1.5cm;">Unit Price</th>
                <th style="max-width: 0.4cm;">Qty</th>
                <th style="max-width: 1.5cm;">Net Amount</th>
                <th style="max-width: 1.5cm;">Tax Rate</th>
                <th style="max-width: 1cm;">Tax Type</th>
                <th style="max-width: 1.5cm;">Tax Amount</th>
                <th style="max-width: 2cm;">Total Amount</th>
            </tr>
        </thead>
        <tbody>
            <% invoice_items.forEach(function(item) { %>
            <tr>
                <td style="max-width: 0.5cm;"><%= item.index %></td>
                <td style="min-width: 5cm;max-width: 5cm;"><%= item.description %></td>
                <td style="max-width: 1.5cm;"><%= item.unit_price %></td>
                <td style="max-width: 0.4cm;"><%= item.quantity %></td>
                <td style="max-width: 1.5cm;"><%= item.net_amount %></td>
                <td style="max-width: 1.5cm;">6%</td>
                <td style="max-width: 1cm;">CGST</td>
                <td style="max-width: 1.5cm;"><%= item.tax_amount %></td>
                <td style="max-width: 2cm;"><%= invoice_total %></td>
            </tr>
            <tr>
                <td style="max-width: 0.5cm;"></td>
                <td style="min-width: 5cm;max-width: 5cm;"></td>
                <td style="max-width: 1.5cm;"></td>
                <td style="max-width: 0.4cm;"></td>
                <td style="max-width: 1.5cm;"></td>
                <td style="max-width: 1.5cm;">6%</td>
                <td style="max-width: 1cm;">SGST</td>
                <td style="max-width: 1.5cm;"><%= item.tax_amount %></td>
                <td style="max-width: 2cm;"></td>
            </tr>
            <% }); %>
            <tr>
                <td colspan="7" class="text-right">Total:</td>
                <td><%= tax_total %></td>
                <td class="total"><%= invoice_total %></td>
            </tr>
        </tbody>
    </table>
    <div class="address-left">
        <h8 style="font-weight: bold;font-size: small;">Declaration</h8>
        <p style="font-size: x-small;max-width: auto;">The sold goods are for end consumer and not for retail sale</p>
    </div>
    <div class="address-right">
        <h5>For <%= company_name %></h5>
        <!-- <p><%= shipping_name %></p> -->
        <img src="<%= sign %>" alt="Company logo" class="logo" width="100" height="50" style="margin-top: 0.5cm;margin-bottom: 0.5cm;">
        <h5>Authorized Signatory</h5>
    </div>
</div>
</body>
</html>
